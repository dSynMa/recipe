channels: c
message-structure: value: boolean
communication-variables: ready: boolean

agent Sender
    local: sent: boolean, count: integer
    init: !sent & count == 2
    relabel: ready <- TRUE
    receive-guard: TRUE
    repeat: send: <TRUE> c! (@ready)(value := TRUE)[sent := TRUE, count := count * 2]

agent Receiver
    local: received: boolean
    init: !received
    relabel: ready <- !received
    receive-guard: channel == c
    repeat: receive: <value> c? [received := value]

system = Sender(sender, TRUE) | Receiver(receiver, TRUE)
