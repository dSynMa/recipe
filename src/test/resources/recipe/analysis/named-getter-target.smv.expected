MODULE main
VAR
	sender-name : {sender,other};
	sender-sent : boolean;
	sender-automaton-state : {0};
	other-name : {sender,other};
	other-sent : boolean;
	other-automaton-state : {0};
	receiver-name : {receiver};
	receiver-received : boolean;
	receiver-automaton-state : {0};
	sender-send : boolean;
	other-send : boolean;
	receiver-receive : boolean;
DEFINE
	falsify-not-sender-send := TRUE;
	falsify-not-sender := (TRUE) & ((next(sender-send)) = (FALSE));
	falsify-sender := (TRUE) & ((next(sender-send)) = (FALSE));
	keep-all-sender := (TRUE) & ((next(sender-name)) = (sender-name)) & ((next(sender-automaton-state)) = (sender-automaton-state)) & ((next(sender-sent)) = (sender-sent)) & ((next(sender-automaton-state)) = (sender-automaton-state)) & ((next(sender-send)) = (FALSE));
	falsify-not-other-send := TRUE;
	falsify-not-other := (TRUE) & ((next(other-send)) = (FALSE));
	falsify-other := (TRUE) & ((next(other-send)) = (FALSE));
	keep-all-other := (TRUE) & ((next(other-name)) = (other-name)) & ((next(other-automaton-state)) = (other-automaton-state)) & ((next(other-sent)) = (other-sent)) & ((next(other-automaton-state)) = (other-automaton-state)) & ((next(other-send)) = (FALSE));
	falsify-not-receiver-receive := TRUE;
	falsify-not-receiver := (TRUE) & ((next(receiver-receive)) = (FALSE));
	falsify-receiver := (TRUE) & ((next(receiver-receive)) = (FALSE));
	keep-all-receiver := (TRUE) & ((next(receiver-name)) = (receiver-name)) & ((next(receiver-automaton-state)) = (receiver-automaton-state)) & ((next(receiver-received)) = (receiver-received)) & ((next(receiver-automaton-state)) = (receiver-automaton-state)) & ((next(receiver-receive)) = (FALSE));
	keep-all := (TRUE) & ((next(sender-send)) = (FALSE)) & (keep-all-sender) & ((next(other-send)) = (FALSE)) & (keep-all-other) & ((next(receiver-receive)) = (FALSE)) & (keep-all-receiver);
	no-observations := TRUE;
	sender-send-receiver-receive := ((((sender-automaton-state) = (0)) & (TRUE)) & ((!(receiver-received = TRUE)) = TRUE) & (((receiver-automaton-state) = (0)) & (TRUE = TRUE)) & (TRUE)) & ((((next(sender-send)) = (TRUE)) & (falsify-not-sender-send)) & (no-observations) & ((next(sender-automaton-state)) = (0)) & ((next(sender-sent)) = (TRUE)) & ((next(sender-name)) = (sender-name))) & ((((next(receiver-receive)) = (TRUE)) & (falsify-not-receiver-receive)) & ((next(receiver-received)) = (TRUE = TRUE)) & ((next(receiver-name)) = (receiver-name)) & ((next(receiver-automaton-state)) = (0)) & (keep-all-other));
	sender-send-receiver-receive-progress := (((sender-automaton-state) = (0)) & (TRUE)) & ((!(receiver-received = TRUE)) = TRUE) & (((receiver-automaton-state) = (0)) & (TRUE = TRUE)) & (TRUE);
	transition := (FALSE) | (sender-send-receiver-receive);
	progress := sender-send-receiver-receive-progress;
CONSTANTS
	sender, other, c, broadcast, receiver;
INIT
((sender-automaton-state) = (0)) & (!(sender-sent = TRUE)) & ((TRUE = TRUE) & (sender-name = sender)) & ((other-automaton-state) = (0)) & (!(other-sent = TRUE)) & ((TRUE = TRUE) & (other-name = other)) & ((receiver-automaton-state) = (0)) & (!(receiver-received = TRUE)) & ((TRUE = TRUE) & (receiver-name = receiver)) & ((sender-send) = (FALSE)) & ((other-send) = (FALSE)) & ((receiver-receive) = (FALSE))
TRANS
	(transition) | ((!(progress)) & (keep-all) & (no-observations))
