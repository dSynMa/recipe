MODULE main
VAR
	sender-name : {sender};
	sender-sent : boolean;
	sender-automaton-state : {0};
	receiver-name : {receiver};
	receiver-received : boolean;
	receiver-automaton-state : {0};
DEFINE
	falsify-not-sender := TRUE;
	falsify-sender := TRUE;
	keep-all-sender := (TRUE) & ((next(sender-name)) = (sender-name)) & ((next(sender-automaton-state)) = (sender-automaton-state)) & ((next(sender-sent)) = (sender-sent)) & ((next(sender-automaton-state)) = (sender-automaton-state));
	falsify-not-receiver := TRUE;
	falsify-receiver := TRUE;
	keep-all-receiver := (TRUE) & ((next(receiver-name)) = (receiver-name)) & ((next(receiver-automaton-state)) = (receiver-automaton-state)) & ((next(receiver-received)) = (receiver-received)) & ((next(receiver-automaton-state)) = (receiver-automaton-state));
	keep-all := (TRUE) & (keep-all-sender) & (keep-all-receiver);
	no-observations := TRUE;
	transition := (((sender-automaton-state) = (0)) & ((TRUE) & ((falsify-sender) & ((next(sender-automaton-state)) = (0)) & ((next(sender-sent)) = (TRUE)) & ((next(sender-name)) = (sender-name))) & ((((receiver-automaton-state) = (0)) & ((broadcast) = (broadcast)) & (keep-all-receiver) & (!((TRUE) & ((broadcast) = (broadcast))))) | (((TRUE) & ((!(receiver-received = TRUE)) = TRUE)) & (((receiver-automaton-state) = (0)) & (((TRUE) & ((broadcast) = (broadcast))) & (((next(receiver-received)) = (TRUE = TRUE)) & ((next(receiver-name)) = (receiver-name)) & (falsify-not-receiver) & ((next(receiver-automaton-state)) = (0)))))) | ((!(TRUE)) & (keep-all-receiver)) | ((((broadcast) = (broadcast)) & (!((!(receiver-received = TRUE)) = TRUE))) & (keep-all-receiver))))) | (FALSE);
	sender-send := ((sender-automaton-state) = (0)) & ((TRUE) & ((((receiver-automaton-state) = (0)) & ((broadcast) = (broadcast)) & (!((TRUE) & ((broadcast) = (broadcast))))) | (((TRUE) & ((!(receiver-received = TRUE)) = TRUE)) & (((receiver-automaton-state) = (0)) & ((TRUE) & ((broadcast) = (broadcast))))) | (!(TRUE)) | (((broadcast) = (broadcast)) & (!((!(receiver-received = TRUE)) = TRUE)))));
	progress := ((sender-automaton-state) = (0)) & ((TRUE) & ((((receiver-automaton-state) = (0)) & ((broadcast) = (broadcast)) & (!((TRUE) & ((broadcast) = (broadcast))))) | (((TRUE) & ((!(receiver-received = TRUE)) = TRUE)) & (((receiver-automaton-state) = (0)) & ((TRUE) & ((broadcast) = (broadcast))))) | (!(TRUE)) | (((broadcast) = (broadcast)) & (!((!(receiver-received = TRUE)) = TRUE)))));
CONSTANTS
	sender, c, broadcast, receiver;
INIT
((sender-automaton-state) = (0)) & (!(sender-sent = TRUE)) & ((TRUE = TRUE) & (sender-name = sender)) & ((receiver-automaton-state) = (0)) & (!(receiver-received = TRUE)) & ((TRUE = TRUE) & (receiver-name = receiver))
TRANS
	(transition) | ((!(progress)) & (keep-all) & (no-observations))
